_topbar_runtime() {
  cat <<'SCRIPT'
<script id="mos-topbar-runtime">
(() => {
  const drawerSelector = '#app > .v-application__wrap > .v-navigation-drawer';
  const actionPaths = new Set(['/mosTools/webterminal', '/mosTools/filebrowser']);

  const translate = (key, fallback) => {
    const app = document.querySelector('#app')?.__vue_app__;
    const translated = app?.config?.globalProperties?.$t?.(key);
    return translated && translated !== key ? translated : fallback;
  };

  const enableDrawer = () => {
    const drawer = document.querySelector(drawerSelector);
    if (drawer?.inert) drawer.inert = false;
  };

  const createStatusRow = () => {
    const toolbar = document.querySelector('#app > .v-application__wrap > .v-app-bar .v-toolbar__content');
    if (!toolbar) return;

    let status = toolbar.querySelector('#mos-topbar-status');
    if (!status) {
      status = document.createElement('div');
      status.id = 'mos-topbar-status';
      status.className = 'mos-topbar-status';
      status.innerHTML = '<img alt="MOS"><span class="mos-topbar-status__host"></span><span class="mos-topbar-status__separator">|</span><span class="mos-topbar-status__detail" data-status="version"></span><span class="mos-topbar-status__separator">|</span><span class="mos-topbar-status__detail" data-status="uptime"></span><span class="mos-topbar-status__separator">|</span><span class="mos-topbar-status__detail" data-status="cpu"></span>';
      toolbar.append(status);
    }

    const logo = status.querySelector('img');
    const sourceLogo = toolbar.querySelector('.v-img img');
    logo.src = sourceLogo?.currentSrc || sourceLogo?.src || '/mos_white.png';

    const host = status.querySelector('.mos-topbar-status__host');
    const originalHost = toolbar.querySelector('.v-toolbar-title')?.textContent?.trim();
    if (originalHost && !host.textContent) host.textContent = originalHost;

    if (!status.dataset.polling) {
      status.dataset.polling = 'true';
      const updateStatus = async () => {
        const token = localStorage.getItem('authToken');
        if (!token) return;
        const headers = { Authorization: `Bearer ${token}` };

        try {
          const [osResponse, loadResponse] = await Promise.all([
            fetch('/api/v1/mos/osinfo', { headers }),
            fetch('/api/v1/system/load', { headers }),
          ]);
          if (osResponse.ok) {
            const info = await osResponse.json();
            host.textContent = info.hostname || originalHost || '';
            const version = status.querySelector('[data-status="version"]');
            version.textContent = info.mos?.version ? `MOS ${info.mos.version}` : '';
            version.hidden = !version.textContent;
            const uptime = status.querySelector('[data-status="uptime"]');
            uptime.textContent = info.uptime?.pretty ? `${translate('uptime', 'Uptime')}: ${info.uptime.pretty}` : '';
            uptime.hidden = !uptime.textContent;
          }
          if (loadResponse.ok) {
            const load = await loadResponse.json();
            const cpu = status.querySelector('[data-status="cpu"]');
            cpu.textContent = Number.isFinite(load.cpu?.load) ? `CPU ${load.cpu.load.toFixed(1)}%` : '';
            cpu.hidden = !cpu.textContent;
          }
        } catch {
          // Keep the last known status while the API is unavailable.
        }
      };

      updateStatus();
      window.setInterval(updateStatus, 15000);
    }
  };

  const hideNativeActionItems = () => {
    const drawer = document.querySelector(drawerSelector);
    if (!drawer) return;

    for (const item of drawer.querySelectorAll('.v-list-item')) {
      const label = (item.innerText || '').trim().toLowerCase();
      if (actionPaths.has(item.getAttribute('href')) || label === 'logout' || label === 'abmelden') {
        item.dataset.mosTopbarActionHidden = 'true';
        item.style.display = 'none';
      }
    }

    for (const group of drawer.querySelectorAll('.v-list-group')) {
      const items = [...group.querySelectorAll('.v-list-group__items .v-list-item')];
      if (items.length && items.every((item) => actionPaths.has(item.getAttribute('href')))) {
        group.style.display = 'none';
      }
    }
  };

  const createActions = () => {
    const toolbar = document.querySelector('#app > .v-application__wrap > .v-app-bar .v-toolbar__content');
    if (!toolbar) return;

    let actions = toolbar.querySelector('#mos-topbar-actions');
    if (!actions) {
      actions = document.createElement('div');
      actions.id = 'mos-topbar-actions';
      actions.className = 'mos-topbar-actions';
      actions.innerHTML = `
        <a class="mos-topbar-action" href="/mosTools/filebrowser" data-label-key="filebrowser" aria-label="Dateibrowser" title="Dateibrowser"><i class="mdi mdi-folder-outline"></i></a>
        <a class="mos-topbar-action" href="/mosTools/webterminal" data-label-key="terminal" aria-label="Terminal" title="Terminal"><i class="mdi mdi-console"></i></a>
        <div class="mos-topbar-more">
          <button class="mos-topbar-action" type="button" data-label-key="more-actions" aria-label="Weitere Aktionen" title="Weitere Aktionen" aria-haspopup="menu" aria-expanded="false"><i class="mdi mdi-dots-vertical"></i></button>
          <div class="mos-topbar-menu" role="menu" hidden>
            <a class="mos-topbar-menu-item" role="menuitem" href="https://docs.mos-official.net" target="_blank" rel="noopener" data-label-key="help"><i class="mdi mdi-lifebuoy"></i><span></span></a>
            <button class="mos-topbar-menu-item" role="menuitem" type="button" data-mos-action="logout" data-label-key="logout"><i class="mdi mdi-logout"></i><span></span></button>
            <div class="mos-topbar-divider"></div>
            <button class="mos-topbar-menu-item" role="menuitem" type="button" data-mos-action="reboot" data-label-key="reboot"><i class="mdi mdi-restart"></i><span></span></button>
            <button class="mos-topbar-menu-item" role="menuitem" type="button" data-mos-action="shutdown" data-label-key="shutdown"><i class="mdi mdi-power"></i><span></span></button>
          </div>
        </div>`;

      const moreButton = actions.querySelector('[aria-haspopup="menu"]');
      const menu = actions.querySelector('.mos-topbar-menu');
      moreButton.addEventListener('click', () => {
        menu.hidden = !menu.hidden;
        moreButton.setAttribute('aria-expanded', String(!menu.hidden));
      });

      actions.addEventListener('click', async (event) => {
        const actionButton = event.target.closest('[data-mos-action]');
        if (!actionButton) return;
        menu.hidden = true;
        moreButton.setAttribute('aria-expanded', 'false');

        if (actionButton.dataset.mosAction === 'logout') {
          const drawer = document.querySelector(drawerSelector);
          const logoutItem = [...(drawer?.querySelectorAll('.v-list-item') || [])]
            .find((item) => ['logout', 'abmelden'].includes((item.innerText || '').trim().toLowerCase()));
          logoutItem?.click();
          return;
        }

        const reboot = actionButton.dataset.mosAction === 'reboot';
        const label = reboot ? 'System jetzt neu starten?' : 'System jetzt herunterfahren?';
        if (!window.confirm(label)) return;

        try {
          const response = await fetch(`/api/v1/system/power/${reboot ? 'reboot' : 'shutdown'}`, {
            method: 'POST',
            headers: { Authorization: `Bearer ${localStorage.getItem('authToken') || ''}` },
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          window.location.href = reboot ? '/reboot.html' : '/shutdown.html';
        } catch (error) {
          window.alert(`Aktion konnte nicht gestartet werden: ${error.message}`);
        }
      });

      document.addEventListener('pointerdown', (event) => {
        if (!actions.contains(event.target)) {
          menu.hidden = true;
          moreButton.setAttribute('aria-expanded', 'false');
        }
      });
      toolbar.append(actions);
    }

    const more = actions.querySelector('.mos-topbar-more');
    const locale = document.querySelector('#app')?.__vue_app__?.config?.globalProperties?.$i18n?.locale;
    const currentLocale = String(locale?.value || locale || 'en').split('-')[0];
    const moreLabels = { de: 'Weitere Aktionen', en: 'More actions', es: 'Más acciones', fr: 'Plus d’actions' };
    const labelFallbacks = {
      filebrowser: 'File browser',
      terminal: 'Terminal',
      'more-actions': 'More actions',
      help: 'Help',
      logout: 'Log out',
      reboot: 'Reboot',
      shutdown: 'Shut down',
    };
    for (const element of actions.querySelectorAll('[data-label-key]')) {
      const key = element.dataset.labelKey;
      const label = key === 'more-actions'
        ? moreLabels[currentLocale] || labelFallbacks[key]
        : translate(key, labelFallbacks[key]);
      if (element.getAttribute('aria-label') !== label) element.setAttribute('aria-label', label);
      if (element.title !== label) element.title = label;
      const text = element.querySelector('span');
      if (text && text.textContent !== label) text.textContent = label;
    }
    const notifications = toolbar.querySelector(':scope > .v-badge') || actions.querySelector('.v-badge');
    const profile = toolbar.querySelector(':scope > a[href="/profile"]') || actions.querySelector('a[href="/profile"]');
    if (notifications && notifications.parentElement !== actions) actions.insertBefore(notifications, more);
    if (profile && profile.parentElement !== actions) actions.insertBefore(profile, more);
    notifications?.setAttribute('title', translate('notifications', 'Notifications'));
    profile?.setAttribute('aria-label', translate('profile', 'Profile'));
    profile?.setAttribute('title', translate('profile', 'Profile'));
  };

  const syncTopbar = () => {
    enableDrawer();
    createStatusRow();
    hideNativeActionItems();
    createActions();
  };

  const observer = new MutationObserver(syncTopbar);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['inert'],
    characterData: true,
    childList: true,
    subtree: true,
  });
  syncTopbar();
})();
</script>
SCRIPT
}

apply_theme() {
  local css_override source_html temp_html theme

  if [ ! -f "$INDEX_HTML" ]; then
    echo "MOS Frontend-Datei nicht gefunden: $INDEX_HTML" >&2
    return 1
  fi

  theme=$(jq -r '.theme // "standard"' "$SETTINGS_FILE" 2>/dev/null || printf 'standard')
  case "$theme" in
    standard|compact|accent) ;;
    *) theme="standard" ;;
  esac

  if grep -q "$STYLE_ID" "$INDEX_HTML"; then
    if [ -f "$BACKUP_HTML" ]; then
      source_html="$BACKUP_HTML"
    else
      temp_html=$(mktemp "$FRONTEND_DIR/.index.html.XXXXXX") || return 1
      if ! awk '
        index($0, "<style id=\"mos-topbar-style\">") { inside = 1; found = 1; next }
        inside && index($0, "</style>") { inside = 0; next }
        inside { next }
        index($0, "<script id=\"mos-topbar-runtime\">") { inside_script = 1; found = 1; next }
        inside_script && index($0, "</script>") { inside_script = 0; next }
        inside_script { next }
        { print }
        END { if (!found || inside || inside_script) exit 1 }
      ' "$INDEX_HTML" > "$temp_html"; then
        rm -f "$temp_html"
        echo "Vorhandene Top-Bar-Styles konnten nicht entfernt werden." >&2
        return 1
      fi
      mv "$temp_html" "$BACKUP_HTML" || {
        rm -f "$temp_html"
        return 1
      }
      source_html="$BACKUP_HTML"
    fi
  else
    if ! cp "$INDEX_HTML" "$BACKUP_HTML"; then
      echo "Original-Frontend konnte nicht gesichert werden." >&2
      return 1
    fi
    source_html="$BACKUP_HTML"
  fi

  css_override=$(_topbar_css "$theme"; _topbar_runtime)
  temp_html=$(mktemp "$FRONTEND_DIR/.index.html.XXXXXX") || return 1

  if ! awk -v css="$css_override" '
    {
      lower = tolower($0)
      position = index(lower, "</head>")
      if (!inserted && position > 0) {
        printf "%s%s%s\n", substr($0, 1, position - 1), css, substr($0, position)
        inserted = 1
      } else {
        print
      }
    }
    END {
      if (!inserted) exit 1
    }
  ' "$source_html" > "$temp_html"; then
    rm -f "$temp_html"
    echo "Kein </head>-Tag in $INDEX_HTML gefunden; Original wurde nicht verändert." >&2
    return 1
  fi

  chmod 644 "$temp_html" && mv "$temp_html" "$INDEX_HTML" || {
    rm -f "$temp_html"
    echo "Top-Bar-Styles konnten nicht installiert werden." >&2
    return 1
  }

  echo "Top Menu Bar wurde mit Theme '$theme' angewendet."
}

install() {
  apply_theme
}

plugin_update() {
  apply_theme
}

mos_start_after_services() {
  apply_theme
}

uninstall() {
  if grep -q "$STYLE_ID" "$INDEX_HTML" 2>/dev/null && [ -f "$BACKUP_HTML" ]; then
    if ! mv "$BACKUP_HTML" "$INDEX_HTML"; then
      echo "MOS Frontend konnte nicht wiederhergestellt werden." >&2
      return 1
    fi
    echo "MOS-Standardnavigation wurde wiederhergestellt."
  elif grep -q "$STYLE_ID" "$INDEX_HTML" 2>/dev/null; then
    echo "Original-Backup fehlt; Frontend wurde zur Sicherheit nicht verändert." >&2
    return 1
  else
    echo "Top Menu Bar ist nicht installiert."
  fi

  rm -f "$BACKUP_HTML"
}