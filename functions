}

apply_theme() {
  local css_override source_html temp_html theme

  if [ ! -f "$INDEX_HTML" ]; then
    echo "MOS Frontend-Datei nicht gefunden: $INDEX_HTML" >&2
    return 1
  fi

  theme=$(jq -r '.theme // "standard"' "$SETTINGS_FILE" 2>/dev/null || printf 'standard')
  case "$theme" in
    standard|compact|accent) ;;
    *) theme="standard" ;;
  esac

  if grep -q "$STYLE_ID" "$INDEX_HTML"; then
    if [ -f "$BACKUP_HTML" ]; then
      source_html="$BACKUP_HTML"
    else
      temp_html=$(mktemp "$FRONTEND_DIR/.index.html.XXXXXX") || return 1
      if ! awk '
        index($0, "<style id=\"mos-topbar-style\">") { inside = 1; found = 1; next }
        inside && index($0, "</style>") { inside = 0; next }
        inside { next }
        index($0, "<script id=\"mos-topbar-runtime\">") { inside_script = 1; found = 1; next }
        inside_script && index($0, "</script>") { inside_script = 0; next }
        inside_script { next }
        { print }
        END { if (!found || inside || inside_script) exit 1 }
      ' "$INDEX_HTML" > "$temp_html"; then
        rm -f "$temp_html"
        echo "Vorhandene Top-Bar-Styles konnten nicht entfernt werden." >&2
        return 1
      fi
      mv "$temp_html" "$BACKUP_HTML" || {
        rm -f "$temp_html"
        return 1
      }
      source_html="$BACKUP_HTML"
    fi
  else
    if ! cp "$INDEX_HTML" "$BACKUP_HTML"; then
      echo "Original-Frontend konnte nicht gesichert werden." >&2
      return 1
    fi
    source_html="$BACKUP_HTML"
  fi

  css_override=$(_topbar_css "$theme"; _topbar_runtime)
  temp_html=$(mktemp "$FRONTEND_DIR/.index.html.XXXXXX") || return 1

  if ! awk -v css="$css_override" '
    {
      lower = tolower($0)
      position = index(lower, "</head>")
      if (!inserted && position > 0) {
        printf "%s%s%s\n", substr($0, 1, position - 1), css, substr($0, position)
        inserted = 1
      } else {
        print
      }
    }
    END {
      if (!inserted) exit 1
    }
  ' "$source_html" > "$temp_html"; then
    rm -f "$temp_html"
    echo "Kein </head>-Tag in $INDEX_HTML gefunden; Original wurde nicht verändert." >&2
    return 1
  fi

  chmod 644 "$temp_html" && mv "$temp_html" "$INDEX_HTML" || {
    rm -f "$temp_html"
    echo "Top-Bar-Styles konnten nicht installiert werden." >&2
    return 1
  }

  echo "Top Menu Bar wurde mit Theme '$theme' angewendet."
}

install() {
  apply_theme
}

plugin_update() {
  apply_theme
}

mos_start_after_services() {
  apply_theme
}

uninstall() {
  if grep -q "$STYLE_ID" "$INDEX_HTML" 2>/dev/null && [ -f "$BACKUP_HTML" ]; then
    if ! mv "$BACKUP_HTML" "$INDEX_HTML"; then
      echo "MOS Frontend konnte nicht wiederhergestellt werden." >&2
      return 1
    fi
    echo "MOS-Standardnavigation wurde wiederhergestellt."
  elif grep -q "$STYLE_ID" "$INDEX_HTML" 2>/dev/null; then
    echo "Original-Backup fehlt; Frontend wurde zur Sicherheit nicht verändert." >&2
    return 1
  else
    echo "Top Menu Bar ist nicht installiert."
  fi

  rm -f "$BACKUP_HTML"
}